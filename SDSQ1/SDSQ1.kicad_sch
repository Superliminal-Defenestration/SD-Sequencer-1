	(text_box "White noise generator:\n\nBreakdown transistor to cause random noise\nAC Coupling via Capacitor\nAmplify!\n\nThis is Mortiz Klein's design :)\n"
		(exclude_from_sim no)
		(at 78.74 15.24 0)
		(size 53.34 16.51)
		(stroke
			(width 0)
			(type default)
